// zaltr.ai — schema fase preview: conversation + message persisten (write-first).
// Branch/summary/memory menyusul sesuai blueprint README.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---- Auth & role (superadmin | admin | user) ----
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String? // null = akun Google-only
  googleId      String?   @unique // sub Google — 1 akun Google = 1 akun zaltr
  avatarUrl     String?
  role          String    @default("user") // superadmin | admin | user
  status        String    @default("pending") // pending | active | suspended
  // Kredit internal zaltr (dipotong oleh provider berbayar, mis. Copilot).
  creditBalance Int       @default(0)
  creditUsed    Int       @default(0)
  // Pola model yang diizinkan: "*", "copilot:*", "ollama:*", id spesifik, dst.
  allowedModels String[]  @default(["zaltr-core"])
  // Paket langganan: free | starter | plus | power (menentukan limit harian default).
  plan          String    @default("free")
  dailyMsgLimit Int? // override manual admin (null = ikut default paket)
  notes         String? // catatan internal admin
  // Instruksi pribadi user (ala ChatGPT custom instructions) — disuntik ke prompt.
  customInstructions String?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  projects      Project[]
  conversations Conversation[]
  memories      Memory[]
  knowledgeSources KnowledgeSource[]
  assistants    Assistant[]
  scheduledTasks ScheduledTask[]
  uploads       Upload[]
  apiKeys       ApiKey[]
  pushSubs      PushSubscription[]
}

// Memori antar-percakapan (ala ChatGPT Memory): fakta personal yang diekstrak
// otomatis oleh model lokal, disuntik ke prompt semua chat user tsb.
model Memory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())

  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique // sha256(token); token mentah hanya di cookie
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Project {
  id            String         @id @default(cuid())
  name          String
  // Instruksi khusus project (ala Claude Projects) — disuntik ke chat dalam project ini.
  instructions  String?
  userId        String?
  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  conversations Conversation[]
  knowledgeSources KnowledgeSource[]

  @@index([updatedAt(sort: Desc)])
  @@index([userId])
}

model Conversation {
  id        String    @id @default(cuid())
  title     String    @default("Chat baru")
  pinned    Boolean   @default(false)
  archived  Boolean   @default(false)
  trashedAt DateTime?
  // Token berbagi read-only (null = tidak dibagikan). Unik utk halaman /share.
  shareToken String?  @unique
  projectId String?
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assistantId String?
  assistant Assistant? @relation(fields: [assistantId], references: [id], onDelete: SetNull)
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]

  @@index([updatedAt(sort: Desc)])
  @@index([projectId])
  @@index([assistantId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // "user" | "assistant" | "system"
  content        String
  model          String?
  provider       String?
  status         String       @default("completed") // completed | stopped | failed
  // Embedding utk pencarian semantik riwayat (nullable; diisi async pasca-simpan).
  embedding      Unsupported("vector(1024)")?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// ---- Basis pengetahuan (RAG): sumber + potongan ber-embedding (pgvector) ----
// Sumber bisa milik user (global) atau terikat Project (knowledge per-project).
model KnowledgeSource {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assistantId String?
  assistant  Assistant? @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  kind       String // upload | drive | text
  name       String
  ref        String? // drive fileId / storage key / null
  bytes      Int      @default(0)
  status     String   @default("pending") // pending | indexed | failed
  chunkCount Int      @default(0)
  embedModel String
  error      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  chunks     KnowledgeChunk[]

  @@index([userId])
  @@index([projectId])
  @@index([assistantId])
}

model KnowledgeChunk {
  id        String   @id @default(cuid())
  sourceId  String
  source    KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  userId    String // denormalisasi utk filter cepat
  projectId String?
  assistantId String?
  idx       Int
  content   String
  embedding Unsupported("vector(1024)")
  createdAt DateTime @default(now())

  @@index([sourceId])
  @@index([userId])
  @@index([projectId])
  @@index([assistantId])
}

// ---- Custom assistant (ala ChatGPT GPTs): instruksi + model preset ----
model Assistant {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  instructions String?
  model        String? // id model preset (mis. copilot:claude-sonnet-4.6)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  conversations Conversation[]
  knowledgeSources KnowledgeSource[]

  @@index([userId])
}

// ---- Tugas terjadwal (ala ChatGPT Tasks): prompt dijalankan otomatis berkala ----
model ScheduledTask {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  prompt          String
  model           String
  intervalMinutes Int // jeda antar-eksekusi (mis. 1440 = harian)
  active          Boolean   @default(true)
  nextRunAt       DateTime
  lastRunAt       DateTime?
  lastResult      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([active, nextRunAt])
  @@index([userId])
}

// ---- Lampiran chat: pelacak kuota + siklus hidup (permanen vs sementara) ----
// File permanen dihitung ke kuota per-user & ikut backup. Bila kuota penuh,
// upload berikut jadi "ephemeral": tetap bisa dipakai AI selama sesi, tidak
// masuk kuota/backup, dan dihapus saat logout / tab ditutup / TTL menganggur.
model Upload {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key          String   @unique // MinIO object key
  name         String
  contentType  String
  size         Int // bytes (maks per file < 2^31)
  ephemeral    Boolean  @default(false)
  sessionId    String? // sesi pemilik (utk file ephemeral)
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([userId, ephemeral])
  @@index([sessionId])
  @@index([ephemeral, lastActiveAt])
}

// ---- API key: akses gateway OpenAI-compatible (/v1) dari luar (mis. VS Code) ----
// Tetap tunduk allowedModels + kredit + limit harian user (kendali super admin).
model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  keyHash    String    @unique // sha256(raw); raw hanya ditampilkan sekali saat dibuat
  prefix     String // beberapa char awal utk ditampilkan (sk-calyzr-xxxx)
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  @@index([userId])
}

// Langganan Web Push (notifikasi ke HP/desktop) per perangkat/browser.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  ua        String?
  createdAt DateTime @default(now())

  @@index([userId])
}
