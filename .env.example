# ============================================================
# CALYZR.AI — contoh konfigurasi lingkungan
#
# Cara pakai:
#   1) Salin file ini:  cp .env.example .env
#   2) Isi nilai yang kosong. Nilai __GENERATE__ bisa diisi otomatis
#      oleh `bin/zaltrctl init`, atau ganti dengan string acak yang kuat.
#   3) JANGAN commit file `.env` (berisi rahasia).
#
# Semua kunci berawalan ZALTR_ dan dibaca langsung oleh aplikasi.
# Kunci yang dibiarkan kosong = fitur terkait nonaktif secara aman.
# ============================================================

# --- Identitas proyek (kunci isolasi namespace Docker) ---
COMPOSE_PROJECT_NAME=zaltr
TZ=Asia/Makassar

# =========================== DATA ===========================
# PostgreSQL 16 + pgvector
ZALTR_POSTGRES_DB=zaltr
ZALTR_POSTGRES_USER=zaltr
ZALTR_POSTGRES_PASSWORD=__GENERATE__

# Redis (rate limit + cache). Isi URL langsung, ATAU host/port/password.
ZALTR_REDIS_URL=
ZALTR_REDIS_HOST=127.0.0.1
ZALTR_REDIS_PORT=6379
ZALTR_REDIS_PASSWORD=__GENERATE__

# MinIO (object storage: lampiran + hasil generasi)
ZALTR_MINIO_URL=http://127.0.0.1:46900
ZALTR_MINIO_ROOT_USER=zaltr-admin
ZALTR_MINIO_ROOT_PASSWORD=__GENERATE__
ZALTR_MINIO_BUCKET_FILES=zaltr-files
ZALTR_MINIO_BUCKET_ASSETS=zaltr-assets

# ====================== AKSES & PUBLIK ======================
# URL publik aplikasi (dipakai untuk link, OAuth redirect, dan email).
ZALTR_PUBLIC_URL=http://localhost:46300

# Login Google (OAuth 2.0).
# Redirect URI: <ZALTR_PUBLIC_URL>/api/auth/google/callback
ZALTR_GOOGLE_CLIENT_ID=
ZALTR_GOOGLE_CLIENT_SECRET=

# ====================== PROVIDER AI =========================
# GitHub Copilot runtime (opsional; profile "ai")
ZALTR_COPILOT_URL=127.0.0.1:46321
ZALTR_COPILOT_CLI_VERSION=1.0.85

# Ollama (model lokal)
ZALTR_OLLAMA_URL=http://127.0.0.1:46434

# ComfyUI (generasi gambar; kosong = fitur nonaktif)
ZALTR_COMFYUI_URL=

# Runner sandbox (eksekusi kode agent; kosong = nonaktif)
ZALTR_RUNNER_URL=

# SearXNG (pencarian web; kosong = nonaktif)
ZALTR_SEARXNG_URL=

# Model default per-fungsi (harus tersedia di Ollama)
ZALTR_FREE_MODEL=llama3.2:latest
ZALTR_EMBED_MODEL=bge-m3:latest
ZALTR_VISION_MODEL=qwen2.5vl:latest
ZALTR_MEMORY_MODEL=llama3.2:latest
ZALTR_SUMMARIZE_MODEL=zaltr-core

# =================== INTEGRASI (opsional) ===================
# Google Drive publik (API key, tanpa OAuth). Aktifkan "Google Drive API".
ZALTR_GOOGLE_API_KEY=
ZALTR_DRIVE_MAX_BYTES=

# Web Push (VAPID). Generate: npx web-push generate-vapid-keys
ZALTR_VAPID_PUBLIC_KEY=
ZALTR_VAPID_PRIVATE_KEY=
ZALTR_VAPID_SUBJECT=mailto:admin@example.com

# Email (SMTP) untuk struk pembayaran & pengingat
ZALTR_SMTP_HOST=
ZALTR_SMTP_PORT=587
ZALTR_SMTP_USER=
ZALTR_SMTP_PASS=
ZALTR_SMTP_FROM=

# Notifikasi admin via Telegram (opsional)
ZALTR_TELEGRAM_BOT_TOKEN=
ZALTR_TELEGRAM_CHAT_ID=

# Tombol beli kredit -> wa.me admin (format 628xxxxxxxx)
ZALTR_WA_ADMIN=

# ==================== BATAS & TUNING ========================
ZALTR_MAX_UPLOAD_MB=500
ZALTR_UPLOAD_QUOTA_GB=5
ZALTR_EPHEMERAL_TTL_HOURS=12
ZALTR_MAX_FILE_CHARS=200000
ZALTR_MAX_TOTAL_CHARS=300000
ZALTR_MAX_CTX_IMAGES=6

# ================= BACKUP TERENKRIPSI =======================
ZALTR_BACKUP_CRON=5 3 * * *
ZALTR_BACKUP_KEEP_DAYS=14
ZALTR_BACKUP_DIR=~/zaltr-backups

# ========== PORT HOST (hanya untuk docker-compose.dev.yml) ==
# Default (tanpa overlay dev): tidak ada port host yang dibuka.
# Nilai di bawah hanya contoh; sesuaikan dengan lingkunganmu.
ZALTR_DEV_BIND=127.0.0.1
ZALTR_DEV_PG_PORT=46432
ZALTR_DEV_REDIS_PORT=46379
ZALTR_DEV_MINIO_PORT=46900
ZALTR_DEV_MINIO_CONSOLE_PORT=46901
ZALTR_DEV_OLLAMA_PORT=46434
ZALTR_DEV_COPILOT_PORT=46321

# ========================= WEB ==============================
ZALTR_WEB_PORT=46300
ZALTR_WEB_BIND=0.0.0.0
# URL provider DARI DALAM container web (nama service di jaringan Docker)
ZALTR_WEB_COPILOT_URL=copilot-runtime:4321
ZALTR_WEB_OLLAMA_URL=http://ollama:11434
