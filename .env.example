# ============================================================
# zaltr.ai — infrastruktur Docker TERISOLASI
# Salin file ini menjadi .env (bin/zaltrctl init melakukannya
# otomatis dan mengganti __GENERATE__ dengan nilai acak).
# JANGAN commit .env.
# ============================================================

# --- Identitas proyek (JANGAN diubah: kunci isolasi namespace) ---
COMPOSE_PROJECT_NAME=zaltr
TZ=Asia/Makassar

# --- PostgreSQL (internal-only secara default) ---
ZALTR_POSTGRES_DB=zaltr
ZALTR_POSTGRES_USER=zaltr
ZALTR_POSTGRES_PASSWORD=__GENERATE__

# --- Redis ---
ZALTR_REDIS_PASSWORD=__GENERATE__

# --- MinIO (object storage: attachment + hasil generation) ---
ZALTR_MINIO_ROOT_USER=zaltr-admin
ZALTR_MINIO_ROOT_PASSWORD=__GENERATE__
ZALTR_MINIO_BUCKET_FILES=zaltr-files
ZALTR_MINIO_BUCKET_ASSETS=zaltr-assets

# --- Backup ---
# Jadwal cron di dalam container backup (WITA). Askara 02:30 dan
# AXON 02:45 sudah terpakai; zaltr memakai 03:05 agar tidak beradu IO.
ZALTR_BACKUP_CRON=5 3 * * *
ZALTR_BACKUP_KEEP_DAYS=14
ZALTR_BACKUP_DIR=/home/muhammadrizalharis/zaltr-backups

# --- Copilot runtime (profile "ai"; TIDAK jalan default) ---
# Versi CLI diambil dari release resmi github/copilot-cli saat build.
ZALTR_COPILOT_CLI_VERSION=1.0.48

# --- Port host (HANYA dipakai docker-compose.dev.yml; default TIDAK ada
#     port yang dibuka sama sekali). Blok 46xxx bebas di server ini per
#     audit 2026-07-29; jangan pindah ke blok proyek lain. ---
ZALTR_DEV_BIND=127.0.0.1
ZALTR_DEV_PG_PORT=46432
ZALTR_DEV_REDIS_PORT=46379
ZALTR_DEV_MINIO_PORT=46900
ZALTR_DEV_MINIO_CONSOLE_PORT=46901
ZALTR_DEV_OLLAMA_PORT=46434
ZALTR_DEV_COPILOT_PORT=46321

# --- Provider untuk web (dev di host; di container nanti pakai nama service) ---
# Copilot runtime CLI headless (profile ai + overlay dev)
ZALTR_COPILOT_URL=127.0.0.1:46321
# Ollama zaltr (profile gpu + overlay dev)
ZALTR_OLLAMA_URL=http://127.0.0.1:46434
# ComfyUI: kosongkan bila belum ada; isi mis. http://127.0.0.1:8188
ZALTR_COMFYUI_URL=
# MinIO S3 API (untuk persist hasil ComfyUI/lampiran)
ZALTR_MINIO_URL=http://127.0.0.1:46900

# --- Dicadangkan untuk fase web (belum dipakai) ---
ZALTR_WEB_PORT=46300
ZALTR_PROXY_HTTP_PORT=46080
ZALTR_PROXY_HTTPS_PORT=46443
